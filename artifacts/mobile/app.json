{
  "expo": {
    "name": "GMS Portal",
    "slug": "mobile",
    "owner": "nishantmore21",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gms-complaints",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gms.portal",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GMS Portal needs access to your location to verify complaint reporting within authorized site boundaries (Geofencing).",
        "NSCameraUsageDescription": "GMS Portal needs access to your camera to take photos as evidence for complaint resolution.",
        "NSPhotoLibraryUsageDescription": "GMS Portal needs access to your photo library to allow uploading existing photos for complaint tracking.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gms.portal",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://gms-complaint-box.netlify.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "organization": "gms-complaints",
          "project": "mobile-app",
          "uploadSourceMaps": false,
          "autoUploadSourceMaps": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "26e99dce-5bb0-44db-b5a4-7a5eb53b0822"
      }
    }
  }
}
